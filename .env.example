# Copy this to `.env` and fill in keys ONLY if you want to use --real (a live model
# plus real web search). Offline mode -- the default -- needs none of this.
#
# `.env` is git-ignored. Never commit real keys.

# The language model (via LiteLLM). Free option: Google Gemini.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model --real uses. Any LiteLLM model string works.
# e.g. gemini/gemini-1.5-flash | groq/llama-3.1-8b-instant | gpt-4o-mini
AGENT_MODEL=gemini/gemini-1.5-flash

# Real web search. Free tier from https://tavily.com
TAVILY_API_KEY=
